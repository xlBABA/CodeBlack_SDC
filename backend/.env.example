# Copy to .env and fill in locally. Never commit real secrets.

APP_NAME=FuturePath AI Backend
APP_VERSION=0.1.0
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

# SQLite now; swap to a Postgres DSN later without code changes.
DATABASE_URL=sqlite:///./futurepath.db

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173

# When true, matching-related routes (careers/match, scenarios/simulate,
# roadmaps/generate, projects/recommend+simulate) use fixture adapters
# (data_mode=fixture). Setting this false signals "I expect real
# inference" — since no real MatchingProvider exists yet, that currently
# makes those routes respond 503 PROVIDER_UNAVAILABLE rather than silently
# serving fixture data anyway.
ENABLE_FIXTURES=true

# Reserved for a future real provider's own HTTP client; nothing in this
# codebase enforces it yet (no real provider makes a blocking call yet).
PROVIDER_TIMEOUT_SECONDS=5.0

# CV extraction LLM. OpenRouter uses only LLM_API_KEY/LLM_BASE_URL/LLM_MODEL;
# leave them unset to use the existing RunPod GLM extraction configuration.
# OpenRouter values: https://openrouter.ai/api/v1 and z-ai/glm-5.3-flashx.
# LLM_TIMEOUT_SECONDS is an httpx phase timeout (not an overall deadline).
LLM_PROVIDER=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60

# Semantic embeddings always use the RunPod Serverless credentials below.
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
TREND_SOURCE_API_KEY=
