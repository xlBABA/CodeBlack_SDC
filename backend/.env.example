# Copy to .env and fill in locally. Never commit real secrets.

APP_NAME=FuturePath AI Backend
APP_VERSION=0.1.0
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

# SQLite now; swap to a Postgres DSN later without code changes.
DATABASE_URL=sqlite:///./futurepath.db

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173

# When true, routers may fall back to fixture adapters (data_mode=fixture).
ENABLE_FIXTURES=true

# Optional — leave blank until a provider is actually integrated.
LLM_PROVIDER=
LLM_API_KEY=
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
TREND_SOURCE_API_KEY=
